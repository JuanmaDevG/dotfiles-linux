#!/usr/bin/env bash

CONFIG_PATH="$(realpath $(dirname "${BASH_SOURCE[0]}"))"

. $CONFIG_PATH/requiretool

PS1=$'\[\033[01;32m\]\u\[\033[37m\]@\[\033[92m\]\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\n\[\033[1;95m\]>\[\033[0m\] '

# Stuff that I don't care about for now
case $- in
*i*) ;;
*) return ;;
esac
#shopt -s globstar
unset HISTFILE
HISTCONTROL=ignoreboth
shopt -s checkwinsize
export LESSHISTFILE=-
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
