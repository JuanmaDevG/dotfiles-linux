#!/usr/bin/env bash

# TODO: add a tool to create new require modules
# TODO: add a subcommand "-e|--env <module>" to check environment variables that a module creates
# TODO: add a subcommand "-f|--funcs <module>" to check functions that a module creates
# TODO: add a subcommand "-x|--executes <module>" to check a summary of what a module executes
require() {
  local tools_dir="$HOME/.local/lib/bash"

  usage_msg() {
    printf "Usage:\nrequire [-h|?|-r|what|no] <module>|<directory>\n"
    printf "  -h            - Show this help message\n"
    printf "  ?             - List loaded modules\n"
    printf "  -r            - Recursive (only for directories)\n"
    printf "  what          - Show tree (what can I 'require')\n"
    printf "  no            - (not implemented yet) Unloads a file's functions and aliaes\n"
    printf "  <module>      - Bash file that contains functions and aliases\n"
    printf "  <directory>   - Import an entire directory (not recursive)\n"
  }
  trap 'unset -f usage_msg' RETURN

  if [ "$1" = "?" ]; then
    local modules=($(compgen -v | grep BASHLIB))
    printf "\e[1mLoaded modules (${#modules[@]}):\e[0m\n"
    for m in ${modules[@]}; do
      printf "${!m}\n"
    done
    return
  fi

  while [ -n "$1" ]; do
    case "$1" in
    -h)
      local entry="-h"
      break
      ;;
    what) local entry="what" ;;
    -r) local recursive=true ;;
    no) local entry="no" ;;
    *) local entry="$tools_dir/$1" ;;
    esac
    shift
  done

  if [ -z "$entry" ] && [[ $- == *i* ]]; then
    printf "\e[1;31mNo arguments, type '\e[32mrequire -h\e[1;31m' for help\e[0m\n"
    return
  fi

  if [ "$entry" = "-h" ]; then
    usage_msg
    return
  fi

  if [ "$entry" = "what" ]; then
    tree "$tools_dir"
    return
  fi

  if [ "$entry" = "no" ]; then
    printf "\e[1;33mThis feature is not implemented yet\e[0m\n"
    printf "Type 'require -h' for help\n"
    return
  fi

  if [ -d "$entry" ]; then
    for f in $(ls "$entry"); do
      local m="$entry/$f"
      if [ -f "$m" ]; then
        . "$m"
      fi
    done
    return
  fi

  . "$entry"
}
