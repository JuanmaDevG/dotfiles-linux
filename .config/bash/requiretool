#!/usr/bin/env bash

# TODO: add a tool to create new requiretool modules
# TODO: add an option "-e|--env <module>" to check environment variables that a module creates (check unset)
# TODO: add an option "-f|--funcs <module>" to check functions that a module creates (check unset -f)
# TODO: add an option "-x|--executes <module>" to check a summary of what a module executes (use awk)
# TODO: add an option "-d|--description <module>" that reads module function descriptions from an xml file
# TODO: make require to write to ~/.cache/requiretool/ dir to accumulate and organize data
# TODO: make a man page and a specific repo
# TODO: if the query result is too long, '?' subcommand will show a less maybe?
# TODO: make the github repository
require() {
  local require_libdir="$HOME/.local/lib/bash"

  local COLORS=("\e[0m" "\e[1m" "\e[31m" "\e[32m" "\e[33m")
  local RESET=0 BOLD=1 RED=2 GREEN=3 YELLOW=4
  local TREE_FLAGS="-C"

  if [ -n "$REQUIRETOOL_DIR" ]; then
    require_libdir=$(realpath $REQUIRETOOL_DIR)
  fi

  [ ! -t 1 ] && unset COLORS TREE_FLAGS
  usage_msg() {
    printf "Usage:\nrequire [-h|==|?|no|-r] <module> ...\n"
    printf "%b\n" \
      "  -h|--help                - Show this help message" \
      "  -r                       - Recursive (use with other options)" \
      "  ==       [module]        - List currently loaded modules" \
      "  ?        [module [-r]]   - Show what can I 'require'" \
      "  no       [module]        - ${COLORS[$RED]}(not implemented yet)${COLORS[$RESET]} Unloads a file's functions and aliaes" \
      "  <module> [-r]            - A file or directory that contains functions and aliases"
  }
  allow_decorators() {
    [[ $- == *i* ]]
  }
  shopt -q globstar
  GLOBSTAR_STATE=$?
  shopt -q nullglob
  NULLGLOB_STATE=$?
  trap "
    unset -f usage_msg allow_decorators
    if [ $NULLGLOB_STATE -eq 0 ]; then
      shopt -s nullglob
    else
      shopt -u nullglob
    fi
    if [ $GLOBSTAR_STATE -eq 0 ]; then
      shopt -s globstar
    else
      shopt -u globstar
    fi
    unset NULLGLOB_STATE GLOBSTAR_STATE
    unset -f cleanup
  " RETURN

  shopt -u globstar nullglob
  while [ -n "$1" ]; do
    case "$1" in
    -r)
      local recursive=true
      ;;
    -h | --help | '?' | no | "==")
      if [ -z "$subcommand" ]; then
        local subcommand="$1"
      fi
      ;;
    *)
      local entry="$require_libdir/$1"
      ;;
    esac
    shift
  done

  # Query has subcommand and maybe entry
  if [ -n "$subcommand" ]; then
    if [ "$subcommand" = "==" ]; then
      local modules=($(compgen -v | grep BASHLIB))
      for i in "${!modules[@]}"; do
        local m=${modules[$i]}
        modules[i]="${!m}"
      done
      if [ -n "$entry" ]; then
        entry=${entry##$require_libdir/}
        for i in "${!modules[@]}"; do
          if [[ "${modules[$i]}" != *"$entry"* ]]; then
            unset 'modules[i]'
          fi
        done
        modules=("${modules[@]}")
      fi
      allow_decorators &&
        printf "${COLORS[$BOLD]}Loaded modules found (${#modules[@]}):${COLORS[$RESET]}\n"
      for m in ${modules[@]}; do
        printf "$m\n"
      done
      return

    elif [ "$subcommand" = "-h" ] || [ "$subcommand" = "--help" ]; then
      usage_msg
      return

    elif [ "$subcommand" = "?" ]; then
      if [ -z $(command -v tree) ]; then
        printf "${COLORS[$YELLOW]}Install 'tree' to get this feature${COLORS[$RESET]}\n"
      fi
      if [ -n "$entry" ]; then
        entry=${entry##$require_libdir/} # Crop libdir to customize search
        shopt -s globstar nullglob
        matches=("$require_libdir"/**/*"$entry"*)
        if [ -z "$matches" ]; then
          allow_decorators && printf "${COLORS[$RED]}no matches${COLORS[$RESET]}\n"
          return 1
        fi
        if allow_decorators && ((${#matches[@]} == 1)) && [ -d "${matches[0]}" ] && [ -n "$recursive" ]; then
          local DIR=$(pwd)
          cd "$require_libdir"
          tree "$TREE_FLAGS" "${matches[0]##$require_libdir/}" $tree_layers
          cd "$DIR"
          return
        fi
        allow_decorators && printf "%b\n" \
          "${COLORS[$BOLD]}Available entries (${#matches[@]}):${COLORS[$RESET]}"
        for i in ${!matches[@]}; do
          if [ -d "${matches[$i]}" ]; then
            local dirmark="/"
          else
            local dirmark=""
          fi
          printf "%s%s\n" \
            "${matches[$i]##$require_libdir/}" \
            "$dirmark"
        done
      else
        tree "$TREE_FLAGS" "$require_libdir" $tree_layers
      fi
      return

    elif [ "$subcommand" = "no" ]; then
      printf "${COLORS[$BOLD]}${COLORS[$YELLOW]}%s${COLORS[$RESET]}\n" \
        "This feature is not implemented yet"
      printf "Type 'require -h' for help\n"
    fi
    return
  # Query has only an entry
  elif [ -n "$entry" ]; then
    if [ -d "$entry" ]; then
      for f in $(ls "$entry"); do
        local m="$entry/$f"
        if [ -f "$m" ]; then
          . "$m"
        elif [ -d "$entry" ] && [ -n "$recursive" ]; then
          require "$entry"
        fi
      done
    elif [ -f "$entry" ]; then
      . "$entry"
    else
      printf "%b\n" \
        "${COLORS[$RED]}ERROR: '${entry##$require_libdir/}' does not exist${COLORS[$RESET]}" \
        "${COLORS[$GREEN]}  type 'require ?' to look for modules${COLORS[$RESET]}"
    fi
  # Error, empty entry
  else
    if allow_decorators; then
      printf "${COLORS[$RED]}%s${COLORS[$GREEN]}%s${COLORS[$RED]}%s${COLORS[$RESET]}\n" \
        "Not enough arguments, type '" "require -h" "' for help"
    fi
    return 1
  fi
}
